# CatSmoker — line-ending and diff policy.
#
# Why this file exists: Git for Windows sets core.autocrlf=true in its *system*
# gitconfig (C:/Program Files/Git/etc/gitconfig), which is invisible to
# `git config --global`. Without explicit attributes, checkouts get CRLF —
# and several files in this repo are executed or parsed, not just read:
#
#   assets/xposed_init is parsed as a class name; a trailing \r corrupts it.
#   gradlew and *.sh are run by sh.
#
# The Magisk module's own scripts used to live in assets/ and needed pinning
# here for the same reason. They are now assembled line-by-line in
# MagiskModuleBuilder, which joins with an explicit \n — so their line endings
# no longer depend on how this repo is checked out at all.
#
# Attributes override core.autocrlf, so this file is the authority.

# Baseline: normalise text to LF in the repository.
* text=auto eol=lf

# ── Must be LF in the working tree, not just in the repo ────────────────────
gradlew                                                        text eol=lf
*.sh                                                           text eol=lf
app/src/main/assets/xposed_init                                 text eol=lf

# ── Must be CRLF: Windows batch ─────────────────────────────────────────────
*.bat                                                          text eol=crlf
*.cmd                                                          text eol=crlf

# ── Binary: never touch these bytes ─────────────────────────────────────────
*.png                                                          binary
*.jpg                                                          binary
*.webp                                                         binary
*.otf                                                          binary
*.ttf                                                          binary
*.jar                                                          binary
*.sav                                                          binary
*.apk                                                          binary
*.aab                                                          binary
*.jks                                                          binary
*.keystore                                                     binary
*.so                                                           binary

# ── Diff/merge hints ────────────────────────────────────────────────────────
*.kt                                                           text diff=java
*.kts                                                          text diff=java
*.java                                                         text diff=java
*.xml                                                          text
*.pro                                                          text
*.md                                                           text
gradle/wrapper/gradle-wrapper.properties                        text eol=lf
