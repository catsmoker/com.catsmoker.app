<?xml version="1.0" encoding="utf-8"?>
<!--
  The reposition banner: a second overlay window shown only while the crosshair is in move mode.

  It exists because the crosshair window itself cannot carry this UI. That window is touchable only
  during move mode and is pinned under the user's finger while dragging, so a "Done" button inside it
  would move with the crosshair and could be dragged off-screen. Keeping the controls in a separate
  window fixed to the top of the screen means the exit from move mode is always reachable — which
  matters, because move mode is the one state where the overlay swallows game taps.

  The hint sits on its own row above the buttons rather than beside them. Laid out in a single
  horizontal row the content wanted ~380dp against a ~360dp portrait screen, and a horizontal
  LinearLayout with no weights hands the shortfall to its last child: "Done" was measured against a
  zero-width AT_MOST spec and collapsed to an empty rounded rect (minWidth cannot beat a 0 spec).
  Stacking removes the competition, so the buttons keep their size at any screen width or font scale
  — and "Done" is the control that ends a mode which is eating the game's taps, so it is the one
  element here that must never be able to render blank.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_crosshair_banner"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/banner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:text="@string/crosshair_move_hint"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/banner_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_crosshair_banner_button"
            android:gravity="center"
            android:minWidth="72dp"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/crosshair_move_recenter"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/banner_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_crosshair_banner_button"
            android:gravity="center"
            android:minWidth="72dp"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/crosshair_move_done"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
