<?xml version="1.0" encoding="utf-8"?>
<!--
    The performance overlay.

    Every row has an id: PerformanceOverlayService writes all nine from the metrics engine, and a
    row it cannot address would sit there showing its placeholder forever, which is how Power,
    Memory and Temp used to read as empty.
-->
<!-- Inflated by PerformanceOverlayService into a TYPE_APPLICATION_OVERLAY window, not an
    Activity, so the theme background never paints behind it: this fill is the only background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#99000000"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- FPS -->
    <TextView
        android:id="@+id/fpsNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_fps_initial"
        android:textColor="#B2FF59"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Frame-time percentiles (p95/p99 ms) from the same SurfaceFlinger dump as FPS -->
    <TextView
        android:id="@+id/frameTimeNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_frametime_initial"
        android:textColor="#B2FF59"
        android:textSize="12sp" />

    <!-- CPU -->
    <TextView
        android:id="@+id/cpuNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_cpu_initial"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Per-cluster MHz (efficiency / performance / ultra) -->
    <TextView
        android:id="@+id/clusterNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_cluster_initial"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- GPU utilization and core clock (vendor sysfs; root/Shizuku on hardened kernels) -->
    <TextView
        android:id="@+id/gpuNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_gpu_initial"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Power -->
    <TextView
        android:id="@+id/powerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_power_initial"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Memory -->
    <TextView
        android:id="@+id/ramNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_ram_initial"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Temp -->
    <TextView
        android:id="@+id/tempNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_temp_initial"
        android:textColor="#FFE0B2"
        android:textSize="12sp" />

    <!-- Thermal headroom (no-privilege forecast; percent of the throttle envelope) -->
    <TextView
        android:id="@+id/headroomNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/overlay_headroom_initial"
        android:textColor="#FFCC80"
        android:textSize="12sp" />

</LinearLayout>
