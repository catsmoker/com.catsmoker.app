<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the reposition banner (the only UI the crosshair overlay shows in move mode).
  Opaque enough to stay readable over a bright game frame, since it carries the instruction that
  tells the user how to leave move mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6121212" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners android:radius="16dp" />
</shape>
